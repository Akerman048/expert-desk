generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  HEAD
  EXPERT
  DESIGNER
  ARCHIVIST
  CLIENT
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  RETURNED
  COMPLETED
  ARCHIVED
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum CommentThreadStatus {
  OPEN
  RESOLVED
  RETURNED
}

enum NotificationType {
  DOCUMENT_SUBMITTED
  DOCUMENT_VERSION_UPLOADED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  DOCUMENT_PUBLISHED
  DOCUMENT_UNPUBLISHED
  COMMENT_THREAD_CREATED
  COMMENT_REPLY_CREATED
  COMMENT_THREAD_RESOLVED
  COMMENT_THREAD_RETURNED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_REMOVED
  INVITATION_ACCEPTED
  PROJECT_ARCHIVED
  PROJECT_RESTORED
  DOCUMENT_ARCHIVED
  DOCUMENT_RESTORED
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum EmailTemplate {
  INVITATION_CREATED
  INVITATION_ACCEPTED
  DOCUMENT_SUBMITTED
  DOCUMENT_VERSION_UPLOADED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  DOCUMENT_PUBLISHED
  COMMENT_THREAD_CREATED
  COMMENT_REPLY_CREATED
  COMMENT_THREAD_RESOLVED
  COMMENT_THREAD_RETURNED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_REMOVED
  PROJECT_ARCHIVED
  PROJECT_RESTORED
  DOCUMENT_ARCHIVED
  DOCUMENT_RESTORED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String?
  role          UserRole  @default(DESIGNER)
  isActive      Boolean   @default(true)
  disabledAt    DateTime?
  emailVerified DateTime?

  emailNotificationsEnabled Boolean @default(true)
  emailDocumentUpdates      Boolean @default(true)
  emailCommentUpdates       Boolean @default(true)
  emailMembershipUpdates    Boolean @default(true)

  memberships             ProjectMember[]
  organizationMemberships OrganizationMember[]
  sentInvitations         Invitation[]         @relation("InvitationSender")
  acceptedInvitations     Invitation[]         @relation("InvitationAcceptedBy")
  documents               Document[]           @relation("AuthoredDocuments")
  publishedDocuments      Document[]           @relation("PublishedDocuments")
  reviewedDocuments       Document[]           @relation("ReviewedDocuments")
  archivedProjects        Project[]            @relation("ArchivedProjects")
  restoredProjects        Project[]            @relation("RestoredProjects")
  archivedDocuments       Document[]           @relation("ArchivedDocuments")
  restoredDocuments       Document[]           @relation("RestoredDocuments")
  documentVersions        DocumentVersion[]
  comments                Comment[]
  createdCommentThreads   CommentThread[]      @relation("CreatedCommentThreads")
  resolvedCommentThreads  CommentThread[]      @relation("ResolvedCommentThreads")
  commentMessages         CommentMessage[]     @relation("CommentMessages")
  deletedCommentMessages  CommentMessage[]     @relation("DeletedCommentMessages")
  notifications           Notification[]       @relation("UserNotifications")
  actedNotifications      Notification[]       @relation("ActorNotifications")
  auditLogs               AuditLog[]
  uploadedArchiveFiles    ArchiveFile[]        @relation("UploadedArchiveFiles")
  deletedArchiveFiles     ArchiveFile[]        @relation("DeletedArchiveFiles")
  accounts                Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Organization {
  id   String @id @default(cuid())
  name String

  projects     Project[]
  members      OrganizationMember[]
  invitations  Invitation[]
  archiveFiles ArchiveFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id       String        @id @default(cuid())
  name     String
  address  String
  customer String
  stage    String
  status   ProjectStatus @default(OPEN)
  deadline DateTime?

  previousStatus ProjectStatus?

  archivedAt    DateTime?
  archivedById  String?
  archivedBy    User?     @relation("ArchivedProjects", fields: [archivedById], references: [id], onDelete: SetNull)
  archiveReason String?

  restoredAt   DateTime?
  restoredById String?
  restoredBy   User?     @relation("RestoredProjects", fields: [restoredById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  members       ProjectMember[]
  invitations   Invitation[]
  documents     Document[]
  auditLogs     AuditLog[]
  notifications Notification[]
  archiveFiles  ArchiveFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([archivedAt])
  @@index([deadline])
}

model OrganizationMember {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role UserRole

  joinedAt  DateTime  @default(now())
  removedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, role])
  @@index([userId, removedAt])
  @@index([organizationId, removedAt])
  @@index([organizationId, role, removedAt])
}

model Invitation {
  id String @id @default(cuid())

  email  String
  role   UserRole
  status InvitationStatus @default(PENDING)

  tokenHash String @unique

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  invitedById String
  invitedBy   User   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  acceptedById String?
  acceptedBy   User?   @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  acceptedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, status])
  @@index([organizationId, status])
  @@index([expiresAt])
}

model ProjectMember {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  role UserRole

  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([projectId, role])
  @@index([userId, role])
}

model Document {
  id     String         @id @default(cuid())
  title  String
  status DocumentStatus @default(DRAFT)

  previousStatus DocumentStatus?

  archivedAt    DateTime?
  archivedById  String?
  archivedBy    User?     @relation("ArchivedDocuments", fields: [archivedById], references: [id], onDelete: SetNull)
  archiveReason String?

  restoredAt   DateTime?
  restoredById String?
  restoredBy   User?     @relation("RestoredDocuments", fields: [restoredById], references: [id], onDelete: SetNull)

  isPublishedToClient Boolean   @default(false)
  publishedAt         DateTime?
  publishedById       String?
  publishedBy         User?     @relation("PublishedDocuments", fields: [publishedById], references: [id], onDelete: SetNull)

  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("ReviewedDocuments", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("AuthoredDocuments", fields: [authorId], references: [id], onDelete: Cascade)

  versions       DocumentVersion[]
  comments       Comment[]
  commentThreads CommentThread[]
  notifications  Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status, createdAt])
  @@index([projectId, status, reviewedAt])
  @@index([authorId, createdAt])
  @@index([authorId, status])
  @@index([reviewedById, reviewedAt])
  @@index([isPublishedToClient, status])
  @@index([archivedAt])
}

model DocumentVersion {
  id      String @id @default(cuid())
  version Int

  objectKey String  @unique
  fileName  String
  mimeType  String
  fileSize  Int
  checksum  String?

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  commentThreads CommentThread[]

  createdAt DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId, createdAt])
  @@index([createdById, createdAt])
}

model ArchiveFile {
  id           String   @id @default(cuid())
  name         String
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String   @unique
  description  String?
  archivedAt   DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("UploadedArchiveFiles", fields: [uploadedById], references: [id], onDelete: Restrict)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("DeletedArchiveFiles", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, archivedAt])
  @@index([organizationId, name])
  @@index([organizationId, deletedAt, archivedAt])
  @@index([projectId])
  @@index([uploadedById])
}

model Comment {
  id      String @id @default(cuid())
  content String

  status CommentStatus @default(OPEN)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommentThread {
  id String @id @default(cuid())

  status CommentThreadStatus @default(OPEN)

  title   String?
  section String?

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  documentVersionId String?
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("CreatedCommentThreads", fields: [createdById], references: [id], onDelete: Restrict)

  resolvedById String?
  resolvedBy   User?   @relation("ResolvedCommentThreads", fields: [resolvedById], references: [id], onDelete: SetNull)

  resolvedAt DateTime?
  returnedAt DateTime?

  legacyCommentId String? @unique

  messages      CommentMessage[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId, status, createdAt])
  @@index([documentId, status, updatedAt])
  @@index([documentVersionId, createdAt])
  @@index([createdById, createdAt])
  @@index([createdById, status])
}

model CommentMessage {
  id String @id @default(cuid())

  content String

  threadId String
  thread   CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("CommentMessages", fields: [authorId], references: [id], onDelete: Restrict)

  editedAt  DateTime?
  deletedAt DateTime?

  deletedById String?
  deletedBy   User?   @relation("DeletedCommentMessages", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
  @@index([deletedAt])
}

model AuditLog {
  id         String @id @default(cuid())
  action     String
  entityType String
  entityId   String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, createdAt])
}

model Notification {
  id String @id @default(cuid())

  type NotificationType

  title   String
  message String
  href    String?

  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  commentThreadId String?
  commentThread   CommentThread? @relation(fields: [commentThreadId], references: [id], onDelete: Cascade)

  readAt DateTime?

  emailJobs EmailJob[]

  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, type, createdAt])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([documentId, createdAt])
  @@index([commentThreadId, createdAt])
}

model EmailJob {
  id String @id @default(cuid())

  template EmailTemplate
  status   EmailJobStatus @default(PENDING)

  recipientEmail String
  recipientName  String?

  subject String
  payload Json

  attempts      Int      @default(0)
  maxAttempts   Int      @default(5)
  nextAttemptAt DateTime @default(now())

  lockedAt DateTime?
  lockedBy String?

  sentAt    DateTime?
  failedAt  DateTime?
  lastError String?

  providerMessageId String?

  notificationId String?
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt, createdAt])
  @@index([recipientEmail, createdAt])
  @@index([notificationId])
}

enum CommentStatus {
  OPEN
  RESOLVED
  RETURNED
}
